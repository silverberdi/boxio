#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

app_id="${1:-}"
image_tag="${2:-}"
if [[ ! "$app_id" =~ ^[a-z][a-z0-9-]{1,30}$ ]]; then
  echo "invalid app id" >&2
  exit 2
fi
if [[ ! "$image_tag" =~ ^[0-9a-f]{40}$ ]]; then
  echo "image tag must be a full Git commit SHA" >&2
  exit 2
fi

app_config="/etc/container-apps/${app_id}.conf"
if [[ ! -f "$app_config" || -L "$app_config" ]]; then
  echo "app is not registered for deployment" >&2
  exit 2
fi
if [[ "$(stat -c '%U:%G:%a' "$app_config")" != "root:root:600" ]]; then
  echo "app deployment config must be root-owned mode 0600" >&2
  exit 2
fi

# These values are root-owned configuration, never supplied by a workflow.
source "$app_config"
if [[ "${COMPOSE_FILE:-}" != "/opt/apps/${app_id}/compose.yaml" || "${ENV_FILE:-}" != "/etc/container-apps/${app_id}.env" ]]; then
  echo "invalid deployment paths for app" >&2
  exit 2
fi
if [[ ! -f "$COMPOSE_FILE" || -L "$COMPOSE_FILE" || ! -f "$ENV_FILE" || -L "$ENV_FILE" ]]; then
  echo "deployment files are missing or symlinked" >&2
  exit 2
fi

state_dir="/var/lib/container-apps/${app_id}"
state_file="${state_dir}/last-good-image-tag"
install -d -o root -g root -m 0700 "$state_dir"
previous_tag=""
if [[ -f "$state_file" ]]; then
  read -r previous_tag < "$state_file"
  [[ "$previous_tag" =~ ^[0-9a-f]{40}$ ]] || previous_tag=""
fi

read -r registry_token
if [[ -z "$registry_token" ]]; then
  echo "registry token is required" >&2
  exit 2
fi
printf '%s' "$registry_token" | docker login ghcr.io --username silverberdi --password-stdin >/dev/null
unset registry_token
trap 'docker logout ghcr.io >/dev/null 2>&1 || true' EXIT

compose=(docker compose --project-name "$app_id" --env-file "$ENV_FILE" --file "$COMPOSE_FILE")
export BOXIO_IMAGE_TAG="$image_tag"
if ! "${compose[@]}" pull || ! "${compose[@]}" up --detach --remove-orphans --wait --wait-timeout 90; then
  if [[ -n "$previous_tag" ]]; then
    echo "deployment failed; restoring last healthy image" >&2
    export BOXIO_IMAGE_TAG="$previous_tag"
    "${compose[@]}" pull || true
    "${compose[@]}" up --detach --remove-orphans --wait --wait-timeout 90 || true
  else
    "${compose[@]}" down --remove-orphans || true
  fi
  exit 1
fi

printf '%s\n' "$image_tag" > "${state_file}.tmp"
chmod 0600 "${state_file}.tmp"
mv -f "${state_file}.tmp" "$state_file"
echo "${app_id} deployed at ${image_tag}"
